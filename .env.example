# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Google Apps Script Web App Attendance Integration:
# Deploy Google Apps Script as a Web App (access: "Anyone") and paste the URL below.
APPS_SCRIPT_WEBAPP_URL=""

# Shared authentication secret between SHIFT 1.0 backend and Google Apps Script Script Properties
APPS_SCRIPT_SHARED_SECRET=""

# Secretariat Staff Console Access Key (used by check-in desk operators)
SECRETARIAT_ACCESS_KEY="SHIFT2026-SECRETARIAT"
